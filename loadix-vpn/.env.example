# --- Backend ---
DATABASE_URL=postgresql+asyncpg://loadix:loadix@postgres:5432/loadix
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change_me_secret

# Внутренний токен — общий для backend и bot (защищает /api/admin, /api/subscription, /api/payments/invoice)
INTERNAL_API_TOKEN=change_me_internal

# --- Bot ---
BOT_TOKEN=put_your_telegram_bot_token
BOT_USERNAME=loadixvpn_bot
ADMIN_TELEGRAM_IDS=123456789,987654321
SUPPORT_USERNAME=support_loadix

# Базовый URL backend для bot. В docker compose оставьте по умолчанию.
BACKEND_BASE_URL=http://backend:8000

# --- CryptoBot ---
CRYPTOBOT_TOKEN=put_your_cryptobot_token
CRYPTOBOT_WEBHOOK_SECRET=change_me_webhook
CRYPTOBOT_ASSET=USDT
CRYPTOBOT_BASE_URL=https://pay.crypt.bot/api

# --- 3X-UI / Xray ---
# Установите XUI_STUB=false когда подключите реальный 3X-UI
XUI_BASE_URL=http://your-vps:54321
XUI_USERNAME=admin
XUI_PASSWORD=admin
XUI_INBOUND_ID=1
XUI_STUB=true

# --- Reality ---
REALITY_PUBLIC_KEY=replace_with_real_pubkey
REALITY_SHORT_ID=00000000
REALITY_SNI=www.cloudflare.com
REALITY_PORT=443
REALITY_FLOW=xtls-rprx-vision

# --- Public domain (для VLESS URI и landing) ---
DOMAIN=example.com
PUBLIC_BASE_URL=https://example.com

# --- Subscription notifications ---
NOTIFY_BEFORE_EXPIRE_HOURS=24

# --- Trial limits ---
TRIAL_DURATION_HOURS=24
TRIAL_TRAFFIC_GB=1
TRIAL_DEVICE_LIMIT=1
